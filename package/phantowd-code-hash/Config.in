config BR2_PACKAGE_PHANTOWD_CODE_HASH
	bool "phantowd-code-hash"
	depends on BR2_ARM_CPU_ARMV5
	select BR2_PACKAGE_NETTLE
	help
	  Fixed descriptor-only read-only hash worker for the EX4 service Owner.
	  Reuses the configured generic C Nettle implementation on ARMv5.
	  Installation reserves its service identity; it does not activate a service.
