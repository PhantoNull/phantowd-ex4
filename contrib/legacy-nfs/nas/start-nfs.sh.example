#!/bin/sh

EXPORT_PATH="/mnt/HD/HD_b2/MediaStack"
CLIENT="192.0.2.10"
ANON_UID="101000"
ANON_GID="101000"

i=0
while ! grep -q ' /mnt/HD/HD_b2 ' /proc/mounts; do
    i=`expr $i + 1`
    [ "$i" -ge 60 ] && exit 1
    sleep 2
done

mkdir -p "$EXPORT_PATH"
chown "$ANON_UID:$ANON_GID" "$EXPORT_PATH"
chmod 2775 "$EXPORT_PATH"

mkdir -p /var/lib/nfs
touch /var/lib/nfs/etab /var/lib/nfs/rmtab /var/lib/nfs/xtab
mkdir -p /proc/fs/nfsd

grep -q ' /proc/fs/nfsd ' /proc/mounts || \
    mount -t nfsd nfsd /proc/fs/nfsd

pidof rpcbind >/dev/null || /usr/sbin/rpcbind
/usr/sbin/rpc.nfsd -N 2 -N 4 -V 3 4
pidof rpc.mountd >/dev/null || \
    /usr/sbin/rpc.mountd -N 2 -N 4 -V 3

/usr/sbin/exportfs -i \
    -o rw,sync,no_subtree_check,all_squash,anonuid="$ANON_UID",anongid="$ANON_GID" \
    "${CLIENT}:${EXPORT_PATH}"

exit 0
