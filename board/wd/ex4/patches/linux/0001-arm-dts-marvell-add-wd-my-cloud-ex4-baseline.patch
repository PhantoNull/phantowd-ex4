index 000000000000..7110f00b0143
--- /dev/null
+++ b/arch/arm/boot/dts/marvell/kirkwood-wd-mycloud-ex4.dts
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Device tree for the Western Digital My Cloud EX4.
+ *
+ * Copyright (c) 2025 bodhi <mibodhi@gmail.com>
+ * Copyright (c) 2026 PhantoWD EX4 contributors
+ *
+ * Research baseline only. This description is incomplete and has not been
+ * validated on hardware.
+ */
+
+/dts-v1/;
+
+#include "kirkwood.dtsi"
+#include "kirkwood-6282.dtsi"
+
+/ {
+	model = "Western Digital My Cloud EX4";
+	compatible = "wd,my-cloud-ex4", "marvell,kirkwood-88f6282",
+		     "marvell,kirkwood";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x20000000>;
+	};
+
+	chosen {
+		stdout-path = &uart0;
+	};
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+		ethernet0 = &eth0port;
+		ethernet1 = &eth1port;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+/*
+ * UART1 is connected to the enclosure management controller according to
+ * community hardware testing. It is not selected as a console.
+ */
+&uart1 {
+	status = "okay";
+};
+
+&sata {
+	nr-ports = <2>;
+	status = "okay";
+};
+
+&mdio {
+	status = "okay";
+
+	ethphy0: ethernet-phy@0 {
+		reg = <0>;
+	};
+
+	ethphy1: ethernet-phy@1 {
+		reg = <1>;
+	};
+};
+
+&eth0 {
+	status = "okay";
+};
+
+&eth0port {
+	phy-handle = <&ethphy0>;
+};
+
+&eth1 {
+	status = "okay";
+};
+
+&eth1port {
+	phy-handle = <&ethphy1>;
+};
+
+&i2c0 {
+	status = "okay";
+};
+
+/* The enclosure uses a separate IDT 1337G RTC path. */
+&rtc {
+	status = "disabled";
+};
+
+&pciec {
+	status = "okay";
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+/* Safety boundary: do not expose unverified raw NAND from this baseline. */
+&nand {
+	status = "disabled";
+};
+
+/* MPP13/14 conflict with UART1; keep SDIO disabled until verified. */
+&sdio {
+	status = "disabled";
+};
-- 
