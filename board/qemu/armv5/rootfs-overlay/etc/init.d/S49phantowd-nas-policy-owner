#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 PhantoWD EX4 contributors
set -eu
[ -f /run/phantowd-nas-policy-boot-profile ] || exit 0
pidfile=/run/phantowd-nas-policy-owner.pid
root=/run/phantowd-nas-policy-boot
case "$1" in
    start)
        [ ! -e "$pidfile" ] && [ ! -e "$root" ] || exit 1
        start-stop-daemon --start --background --make-pidfile --pidfile "$pidfile" \
            --exec /usr/bin/phantowd-api -- --qemu-nas-policy-owner-service
        attempt=0
        while [ ! -f "$root/ready" ]; do
            kill -0 "$(cat "$pidfile")" || exit 1
            attempt=$((attempt + 1)); [ "$attempt" -lt 10 ] || exit 1
            sleep 1
        done
        [ -S "$root/channel" ] && kill -0 "$(cat "$pidfile")" || exit 1
        cat "$root/ready"
        echo 'PHANTOWD_NAS_PROVIDER_INIT_READY before_api=true runtime=run'
        ;;
    stop) start-stop-daemon --stop --pidfile "$pidfile" --exec /usr/bin/phantowd-api ;;
    *) exit 1 ;;
esac
