#!/bin/sh

case "$1" in
    start)
        # shellcheck disable=SC1091 # installed into the target rootfs
        . /etc/phantowd-release
        running_kernel="$(uname -r)"
        running_arch="$(uname -m)"

        if [ "$running_kernel" != "$PHANTOWD_KERNEL_VERSION" ]; then
            echo "PHANTOWD_QEMU_ERROR expected-kernel=$PHANTOWD_KERNEL_VERSION actual-kernel=$running_kernel"
            exit 1
        fi

        case "$running_arch" in
            armv5*) ;;
            *)
                echo "PHANTOWD_QEMU_ERROR expected-arch=armv5 actual-arch=$running_arch"
                exit 1
                ;;
        esac

        # Probe only guest loopback; no guest-to-LAN or host forwarding exists.
        for api_license in LICENSE Go-LICENSE; do
            if [ ! -s "/usr/share/licenses/phantowd-api/$api_license" ]; then
                echo 'PHANTOWD_QEMU_ERROR diagnostics-license-missing'
                exit 1
            fi
        done
        api_attempt=0
        while ! /usr/bin/phantowd-api --self-test 2>/dev/null; do
            api_attempt=$((api_attempt + 1))
            if [ "$api_attempt" -ge 5 ]; then
                echo 'PHANTOWD_QEMU_ERROR diagnostics-api-unavailable'
                exit 1
            fi
            sleep 1
        done
        api_pid="$(cat /run/phantowd-api.pid)"
        api_rss="$(awk '/^VmRSS:/ { print $2 }' "/proc/$api_pid/status")"
        case "$api_rss" in
            ''|*[!0-9]*)
                echo 'PHANTOWD_QEMU_ERROR diagnostics-api-rss-unavailable'
                exit 1
                ;;
        esac
        if [ "$api_rss" -gt 49152 ]; then
            echo 'PHANTOWD_QEMU_ERROR diagnostics-api-rss-budget-exceeded'
            exit 1
        fi
        echo "PHANTOWD_API_RESOURCE rss_kib=$api_rss scope=qemu-smoke-only"

        nfs_daemon_rss_kib=0
        for nfs_daemon in rpcbind rpc.statd rpc.mountd; do
            nfs_daemon_pids="$(pidof "$nfs_daemon" 2>/dev/null || true)"
            if [ -z "$nfs_daemon_pids" ]; then
                echo "PHANTOWD_QEMU_ERROR nfs-daemon-not-running name=$nfs_daemon"
                exit 1
            fi
            for nfs_daemon_pid in $nfs_daemon_pids; do
                nfs_daemon_rss="$(awk '/^VmRSS:/ { print $2 }' "/proc/$nfs_daemon_pid/status")"
                case "$nfs_daemon_rss" in
                    ''|*[!0-9]*)
                        echo "PHANTOWD_QEMU_ERROR nfs-daemon-rss-unavailable name=$nfs_daemon"
                        exit 1
                        ;;
                esac
                nfs_daemon_rss_kib=$((nfs_daemon_rss_kib + nfs_daemon_rss))
            done
        done
        echo "PHANTOWD_NFS_RESOURCE userspace_daemons=rpcbind,rpc.statd,rpc.mountd rss_kib=$nfs_daemon_rss_kib scope=qemu-smoke-only"

        nfs_mount=/run/phantowd-nfs-smoke
        mkdir -p "$nfs_mount"
        if ! mount -t nfs -o vers=3,proto=tcp,nolock,ro,soft,timeo=5,retrans=1 \
            127.0.0.1:/srv/phantowd-nfs-smoke "$nfs_mount"; then
            echo 'PHANTOWD_QEMU_ERROR nfs-v3-tcp-loopback-mount-failed'
            exit 1
        fi
        if [ "$(cat "$nfs_mount/marker" 2>/dev/null)" != 'phantowd-qemu-nfs-smoke-v1' ]; then
            umount "$nfs_mount" || true
            echo 'PHANTOWD_QEMU_ERROR nfs-v3-tcp-loopback-content-mismatch'
            exit 1
        fi
        if ! awk -v mountpoint="$nfs_mount" \
            '$2 == mountpoint && $3 == "nfs" && $4 ~ /vers=3/ && $4 ~ /proto=tcp/ { found=1 } END { exit !found }' \
            /proc/mounts; then
            umount "$nfs_mount" || true
            echo 'PHANTOWD_QEMU_ERROR nfs-v3-tcp-mount-options-unverified'
            exit 1
        fi
        if ! umount "$nfs_mount"; then
            echo 'PHANTOWD_QEMU_ERROR nfs-v3-tcp-loopback-unmount-failed'
            exit 1
        fi
        echo 'PHANTOWD_NFS_SMOKE_READY protocol=nfs3 transport=tcp scope=qemu-loopback-only'

        smb_marker=/run/phantowd-smb-marker
        smb_client_log=/run/phantowd-smbclient.log
        rm -f "$smb_marker"
        smb_attempt=0
        while ! smbclient -N -t 2 -m SMB3 //127.0.0.1/phantowd-smb-smoke \
            -c "get marker $smb_marker" >"$smb_client_log" 2>&1; do
            smb_attempt=$((smb_attempt + 1))
            if [ "$smb_attempt" -ge 30 ]; then
                echo 'PHANTOWD_QEMU_ERROR smb3-loopback-read-failed'
                cat "$smb_client_log" 2>/dev/null || true
                grep -i ':01BD ' /proc/net/tcp /proc/net/tcp6 2>/dev/null || true
                cat /var/log/samba/testparm.log 2>/dev/null || true
                tail -n 40 /var/log/samba/smbd-startup.log 2>/dev/null || true
                exit 1
            fi
            sleep 1
        done
        if [ ! -s "$smb_marker" ]; then
            echo 'PHANTOWD_QEMU_ERROR smb3-loopback-read-failed'
            exit 1
        fi
        if [ "$(cat "$smb_marker" 2>/dev/null)" != 'phantowd-qemu-smb-smoke-v1' ]; then
            rm -f "$smb_marker"
            echo 'PHANTOWD_QEMU_ERROR smb3-loopback-content-mismatch'
            exit 1
        fi
        rm -f "$smb_marker"
        echo 'PHANTOWD_SMB_SMOKE_READY protocol=smb3 transport=tcp scope=qemu-loopback-only'

        smb_daemon_rss_kib=0
        smb_daemon_pids="$(pidof smbd 2>/dev/null || true)"
        if [ -z "$smb_daemon_pids" ]; then
            echo 'PHANTOWD_QEMU_ERROR smb-daemon-not-running name=smbd'
            exit 1
        fi
        # shellcheck disable=SC2086 # pidof intentionally returns a whitespace-separated PID list
        for smb_daemon_pid in $smb_daemon_pids; do
            smb_daemon_rss="$(awk '/^VmRSS:/ { print $2 }' "/proc/$smb_daemon_pid/status")"
            case "$smb_daemon_rss" in
                ''|*[!0-9]*)
                    echo 'PHANTOWD_QEMU_ERROR smb-daemon-rss-unavailable name=smbd'
                    exit 1
                    ;;
            esac
            smb_daemon_rss_kib=$((smb_daemon_rss_kib + smb_daemon_rss))
        done
        echo "PHANTOWD_SMB_RESOURCE userspace_daemons=smbd rss_kib=$smb_daemon_rss_kib scope=qemu-smoke-only"
        echo "PHANTOWD_QEMU_READY target=$PHANTOWD_TARGET kernel=$running_kernel arch=$running_arch flashable=$PHANTOWD_FLASHABLE"
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
