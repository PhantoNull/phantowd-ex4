 struct tevent_req *smb2srv_session_close_previous_send(
--- a/source3/utils/status.c
+++ b/source3/utils/status.c
@@ -63,2 +63,9 @@
 #endif /* HAVE_JANSSON */
+
+enum session_scan_exit {
+	SESSION_SCAN_CALLBACK_STOP = 20,
+	SESSION_SCAN_PARTIAL_RECORD = 21,
+	SESSION_SCAN_SERIALIZATION = 22,
+	SESSION_SCAN_WATCHED_RECORD = 23,
+};
 
@@ -703,3 +710,3 @@
 	} else {
-		add_section_to_json(state, "sessions");
+		return add_section_to_json(state, "sessions");
 	}
@@ -1214,4 +1221,25 @@
 	if ( show_processes ) {
-		prepare_sessionid(&state);
-		sessionid_traverse_read(traverse_sessionid, &state);
+		NTSTATUS session_status;
+		if (prepare_sessionid(&state) != 0) {
+			ret = SESSION_SCAN_SERIALIZATION;
+			fprintf(stderr, "Session scan refused: JSON preparation failed\n");
+			goto done;
+		}
+		session_status = sessionid_traverse_read_complete(traverse_sessionid, &state);
+		if (!NT_STATUS_IS_OK(session_status)) {
+			if (NT_STATUS_EQUAL(session_status, NT_STATUS_FILE_CORRUPT_ERROR)) {
+				ret = SESSION_SCAN_WATCHED_RECORD;
+				fprintf(stderr, "Session scan refused: malformed watched record\n");
+			} else if (NT_STATUS_EQUAL(session_status, NT_STATUS_INFO_LENGTH_MISMATCH)) {
+				ret = SESSION_SCAN_PARTIAL_RECORD;
+				fprintf(stderr, "Session scan refused: partial record\n");
+			} else if (NT_STATUS_EQUAL(session_status, NT_STATUS_REQUEST_ABORTED)) {
+				ret = SESSION_SCAN_CALLBACK_STOP;
+				fprintf(stderr, "Session scan refused: callback stopped\n");
+			} else {
+				ret = 1;
+				fprintf(stderr, "Session scan unavailable\n");
+			}
+			goto done;
+		}
 
@@ -1301,4 +1329,8 @@
 #ifdef HAVE_JANSSON
-	if (state.json_output) {
-		d_printf("%s\n", json_to_string(frame, &state.root_json));
+	if (state.json_output && ret == 0) {
+		const char *serialized = json_to_string(frame, &state.root_json);
+		if (serialized == NULL || d_printf("%s\n", serialized) < 0) {
+			ret = SESSION_SCAN_SERIALIZATION;
+			fprintf(stderr, "Session scan refused: serialization failed\n");
+		}
 	}
