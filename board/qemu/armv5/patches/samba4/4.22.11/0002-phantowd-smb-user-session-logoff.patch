+struct smbXsrv_session_logoff_user_state {
+	const char *username;
+	NTSTATUS first_status;
+	int errors;
+};
+
+static int smbXsrv_session_logoff_user_callback(struct db_record *local_rec,
+						void *private_data)
+{
+	struct smbXsrv_session_logoff_user_state *state = private_data;
+	TDB_DATA val;
+	void *ptr = NULL;
+	struct smbXsrv_session *session = NULL;
+	struct auth_session_info *session_info = NULL;
+	NTSTATUS status;
+
+	val = dbwrap_record_get_value(local_rec);
+	if (val.dsize != sizeof(ptr)) {
+		status = NT_STATUS_INTERNAL_ERROR;
+		if (NT_STATUS_IS_OK(state->first_status)) {
+			state->first_status = status;
+		}
+		state->errors++;
+		return 0;
+	}
+
+	memcpy(&ptr, val.dptr, val.dsize);
+	session = talloc_get_type_abort(ptr, struct smbXsrv_session);
+	if (session->global == NULL) {
+		return 0;
+	}
+	session_info = session->global->auth_session_info;
+	if (session_info == NULL || session_info->unix_info == NULL ||
+	    session_info->unix_info->unix_name == NULL) {
+		/* An unauthenticated in-progress connection has no target user. */
+		return 0;
+	}
+	if (strcmp(session_info->unix_info->unix_name, state->username) != 0) {
+		return 0;
+	}
+
+	session->db_rec = local_rec;
+	status = smbXsrv_session_clear_and_logoff(session);
+	session->db_rec = NULL;
+	if (!NT_STATUS_IS_OK(status)) {
+		if (NT_STATUS_IS_OK(state->first_status)) {
+			state->first_status = status;
+		}
+		state->errors++;
+	}
+
+	return 0;
+}
+
+NTSTATUS smbXsrv_session_logoff_user(struct smbXsrv_client *client,
+				     const char *username)
+{
+	struct smbXsrv_session_table *table = NULL;
+	struct smbXsrv_session_logoff_user_state state = {
+		.username = username,
+		.first_status = NT_STATUS_OK,
+	};
+	NTSTATUS status;
+	int count = 0;
+
+	if (client == NULL || username == NULL || username[0] == '\0') {
+		return NT_STATUS_INVALID_PARAMETER;
+	}
+	table = client->session_table;
+	if (table == NULL) {
+		return NT_STATUS_OK;
+	}
+
+	status = dbwrap_traverse(table->local.db_ctx,
+				 smbXsrv_session_logoff_user_callback,
+				 &state, &count);
+	if (!NT_STATUS_IS_OK(status)) {
+		DBG_ERR("dbwrap_traverse() failed: %s\n", nt_errstr(status));
+		return status;
+	}
+	if (!NT_STATUS_IS_OK(state.first_status)) {
+		DBG_ERR("count[%d] errors[%d] first[%s]\n",
+			count, state.errors, nt_errstr(state.first_status));
+		return state.first_status;
+	}
+	return NT_STATUS_OK;
+}
