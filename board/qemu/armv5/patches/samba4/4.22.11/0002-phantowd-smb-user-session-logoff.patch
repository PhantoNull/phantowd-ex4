+/* Log off one Unix account's local SMB sessions without killing its worker. */
+static bool do_logoff_user(struct tevent_context *ev_ctx,
+			struct messaging_context *msg_ctx,
+			const struct server_id pid,
+			const int argc,
+			const char **argv)
+{
+	if (argc != 2 || argv[1][0] == '\0' || strpbrk(argv[1], "\r\n") != NULL) {
+			fprintf(stderr, "Usage: smbcontrol <dest> logoff-user <username>\n");
+			return false;
+	}
+
+	return send_message(msg_ctx, pid, MSG_SMB_LOGOFF_USER,
+			argv[1], strlen(argv[1]) + 1);
+}
