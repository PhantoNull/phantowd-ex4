+static void msg_logoff_user(struct messaging_context *msg_ctx,
+			    void *private_data,
+			    uint32_t msg_type,
+			    struct server_id server_id,
+			    DATA_BLOB *data)
+{
+	struct smbd_server_connection *sconn = talloc_get_type_abort(
+		private_data, struct smbd_server_connection);
+	const char *username = NULL;
+	NTSTATUS status;
+
+	if (data == NULL || data->data == NULL || data->length < 2 ||
+	    data->data[data->length - 1] != '\0' ||
+	    memchr(data->data, '\0', data->length - 1) != NULL) {
+		DBG_WARNING("Ignoring invalid logoff-user message\n");
+		return;
+	}
+	username = (const char *)data->data;
+	if (username[0] == '\0' || strpbrk(username, "\r\n") != NULL) {
+		DBG_WARNING("Ignoring invalid logoff-user account name\n");
+		return;
+	}
+
+	status = smbXsrv_session_logoff_user(sconn->client, username);
+	if (!NT_STATUS_IS_OK(status)) {
+		DBG_ERR("Could not log off SMB sessions for %s: %s\n",
+			username, nt_errstr(status));
+	}
+}
