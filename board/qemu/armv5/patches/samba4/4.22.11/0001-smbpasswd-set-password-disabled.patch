From 1ad961fa3166e48210a93c79827d91fe5cb9d384 Mon Sep 17 00:00:00 2001
From: PhantoNull <65261018+PhantoNull@users.noreply.github.com>
Date: Mon, 28 Sep 2026 14:00:59 +0200
Subject: [PATCH] smbpasswd: set password while requiring disabled account
SPDX-License-Identifier: GPL-3.0-or-later

---
 source3/include/passdb.h  |  1 +
 source3/passdb/passdb.c   | 21 ++++++++++++++++++++
 source3/utils/smbpasswd.c | 40 ++++++++++++++++++++++++++++++++++++++-
 3 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/source3/include/passdb.h b/source3/include/passdb.h
index 5ee60d3..82f22f9 100644
--- a/source3/include/passdb.h
+++ b/source3/include/passdb.h
@@ -156,6 +156,7 @@ NTSTATUS pdb_create_builtin_alias(uint32_t rid, gid_t gid);
 #define LOCAL_SET_LDAP_ADMIN_PW 0x80
 #define LOCAL_INTERDOM_ACCOUNT 0x100
 #define LOCAL_AM_ROOT 0x200  /* Act as root */
+#define LOCAL_REQUIRE_DISABLED 0x400 /* Password update requires a disabled account */
 
 /*
  * Size of new password account encoding string.  This is enough space to
diff --git a/source3/passdb/passdb.c b/source3/passdb/passdb.c
index 229e163..3915065 100644
--- a/source3/passdb/passdb.c
+++ b/source3/passdb/passdb.c
@@ -725,6 +725,27 @@ NTSTATUS local_password_change(const char *user_name,
 
 	/* Get the smb passwd entry for this user */
 	user_exists = pdb_getsampwnam(sam_pass, user_name);
+	if (local_flags & LOCAL_REQUIRE_DISABLED) {
+		int incompatible_flags = LOCAL_ADD_USER | LOCAL_DELETE_USER |
+			LOCAL_ENABLE_USER | LOCAL_SET_NO_PASSWORD |
+			LOCAL_SET_LDAP_ADMIN_PW | LOCAL_TRUST_ACCOUNT |
+			LOCAL_INTERDOM_ACCOUNT;
+		int required_flags = LOCAL_SET_PASSWORD | LOCAL_DISABLE_USER;
+
+		if (!user_exists ||
+		    (local_flags & incompatible_flags) != 0 ||
+		    (local_flags & required_flags) != required_flags ||
+		    !(pdb_get_acct_ctrl(sam_pass) & ACB_DISABLED)) {
+			ret = asprintf(pp_err_str,
+					"Disabled-password update requires an existing "
+					"disabled account for user %s.\n", user_name);
+			if (ret < 0) {
+				*pp_err_str = NULL;
+			}
+			result = NT_STATUS_ACCESS_DENIED;
+			goto done;
+		}
+	}
 
 	/* Check delete first, we don't need to do anything else if we
 	 * are going to delete the account */
diff --git a/source3/utils/smbpasswd.c b/source3/utils/smbpasswd.c
index f2c5dfd..fef3209 100644
--- a/source3/utils/smbpasswd.c
+++ b/source3/utils/smbpasswd.c
@@ -17,6 +17,7 @@
  * this program; if not, see <http://www.gnu.org/licenses/>.  */
 
 #include "includes.h"
+#include <getopt.h>
 #include "system/passwd.h"
 #include "secrets.h"
 #include "../librpc/gen_ndr/samr.h"
@@ -43,6 +44,7 @@ static fstring user_name;
 static char *new_passwd = NULL;
 static const char *remote_machine = NULL;
 
+static bool set_password_disabled = False;
 static fstring ldap_secret;
 
 
@@ -61,6 +63,7 @@ static void usage(void)
 	printf("  -h                   print this usage message\n");
 	printf("  -s                   use stdin for password prompt\n");
 	printf("  -c smb.conf file     Use the given path to the smb.conf file\n");
+	printf("  --set-password-disabled  set password on an existing disabled account\n");
 	printf("  -D LEVEL             debug level\n");
 	printf("  -r MACHINE           remote machine\n");
 	printf("  -U USER              remote username (e.g. SAM/user)\n");
@@ -94,6 +97,12 @@ static int process_options(int argc, char **argv, int local_flags,
 {
 	int ch;
 	const char *configfile = get_dyn_CONFIGFILE();
+	bool positional_username = False;
+	bool local_mode_requested = False;
+	static const struct option long_options[] = {
+		{ "set-password-disabled", no_argument, NULL, 256 },
+		{ NULL, 0, NULL, 0 }
+	};
 
 	local_flags |= LOCAL_SET_PASSWORD;
 
@@ -101,9 +110,18 @@ static int process_options(int argc, char **argv, int local_flags,
 
 	user_name[0] = '\0';
 
-	while ((ch = getopt(argc, argv, "c:axdehminjr:sw:R:D:U:LWS:")) != EOF) {
+	while ((ch = getopt_long(argc, argv, "c:axdehminjr:sw:R:D:U:LWS:",
+				 long_options, NULL)) != EOF) {
 		switch(ch) {
+		case 256:
+			if (getuid() != 0) {
+				fprintf(stderr, "smbpasswd --set-password-disabled can only be used by root.\n");
+				exit(1);
+			}
+			set_password_disabled = True;
+			break;
 		case 'L':
+			local_mode_requested = True;
 			if (getuid() != 0) {
 				fprintf(stderr, "smbpasswd -L can only be used by root.\n");
 				exit(1);
@@ -195,6 +213,7 @@ static int process_options(int argc, char **argv, int local_flags,
 				usage();
 			} else {
 				fstrcpy(user_name, argv[0]);
+				positional_username = True;
 			}
 		}
 		break;
@@ -202,6 +221,25 @@ static int process_options(int argc, char **argv, int local_flags,
 		usage();
 	}
 
+	if (set_password_disabled) {
+		int incompatible_flags = LOCAL_ADD_USER | LOCAL_DELETE_USER |
+			LOCAL_DISABLE_USER | LOCAL_ENABLE_USER | LOCAL_TRUST_ACCOUNT |
+			LOCAL_SET_NO_PASSWORD | LOCAL_SET_LDAP_ADMIN_PW |
+			LOCAL_INTERDOM_ACCOUNT;
+
+		if (!stdin_passwd_get) {
+			fprintf(stderr, "--set-password-disabled requires -s for password input.\n");
+			exit(1);
+		}
+		if (!positional_username || got_username || remote_machine != NULL ||
+		    local_mode_requested || (local_flags & incompatible_flags) != 0) {
+			fprintf(stderr, "--set-password-disabled requires one local username and cannot be combined with other account operations.\n");
+			exit(1);
+		}
+		local_flags |= LOCAL_SET_PASSWORD | LOCAL_DISABLE_USER |
+			LOCAL_REQUIRE_DISABLED;
+	}
+
 	if (!lp_load_global(configfile)) {
 		fprintf(stderr, "Can't load %s - run testparm to debug it\n",
 			configfile);
-- 
2.55.0.windows.3
