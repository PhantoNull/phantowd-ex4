From: PhantoWD EX4 contributors
Subject: [PATCH] go: select the qualified 1.26.8 maintenance candidate

Keep the 1.26 cgo workaround and the unchanged LICENSE hash. Update every
source/host archive in the common Go recipe together. Archive hashes are
published at https://go.dev/dl/?mode=json for go1.26.8.

--- a/package/go/go.mk
+++ b/package/go/go.mk
@@ -7,7 +7,7 @@
 # When bumping this to 1.27 (or beyond), remove the workaround for
 # upstream issue https://github.com/golang/go/issues/77436, below
 # (i.e. revert the commit adding these lines).
-GO_VERSION = 1.26.6
+GO_VERSION = 1.26.8
 
 HOST_GO_GOPATH = $(HOST_DIR)/share/go-path
 HOST_GO_HOST_CACHE = $(HOST_DIR)/share/host-go-cache
--- a/package/go/go.hash
+++ b/package/go/go.hash
