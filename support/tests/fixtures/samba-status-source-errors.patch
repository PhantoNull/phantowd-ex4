+			goto done;
+		}
+		session_status = sessionid_traverse_read(traverse_sessionid, &state);
+		if (!NT_STATUS_IS_OK(session_status)) {
+			fprintf(stderr, "Session inventory unavailable\n");
+			ret = 1;
+			goto done;
+		}
 
 		if (processes_only) {
 			goto done;
@@ -1300,7 +1309,7 @@
 	cmdline_messaging_context_free();
